# Copy to `.env.local` for local development (Expo loads this automatically).
#
# THREE settings must match the environment you want:
#
#   APP_VARIANT=staging|production
#     → App package ID only (insure.kale.mobile.staging vs insure.kale.mobile)
#
#   EXPO_PUBLIC_FIREBASE_*
#     → Which Firebase project Auth/Firestore use (staging OR production keys)
#
#   EXPO_PUBLIC_KALE_API_BASE
#     → kale-website host for Strava/Garmin OAuth + claim/assess APIs
#     → Staging local: http://localhost:3000 (simulator) or http://YOUR_LAN_IP:3000 (physical device)
#     → Production: https://www.kale.insure
#     → Alias also supported: EXPO_PUBLIC_KALE_API_BASE_URL
#
# Strava/Garmin client secrets live in kale-website `.env.local` only — NOT here.
#
# APP_VARIANT does NOT switch Firebase. You must set EXPO_PUBLIC_* to the
# matching project's keys. After any .env change: npx expo start --clear
#
# EAS builds: set EXPO_PUBLIC_* as EAS secrets per profile.
#
# Do NOT put Firebase keys in eas.json (they belong in EAS env/secrets only):
#
#   eas env:create --environment development --name EXPO_PUBLIC_FIREBASE_API_KEY --value "..."
#   eas env:create --environment preview --name EXPO_PUBLIC_FIREBASE_API_KEY --value "..."
#   eas env:create --environment production --name EXPO_PUBLIC_FIREBASE_API_KEY --value "..."
#
# Repeat for each EXPO_PUBLIC_FIREBASE_* variable. Use staging keys for development/preview
# and production keys for production. See: https://docs.expo.dev/eas/environment-variables/

APP_VARIANT=staging

# Local iOS builds without Associated Domains on your App ID (optional)
# IOS_ASSOCIATED_DOMAINS=0

# kale-website running locally (`npm run dev` in kale-website repo)
# Simulator: localhost works. Physical device: use your Mac's LAN IP (find with `ipconfig getifaddr en0`)
EXPO_PUBLIC_KALE_API_BASE=http://localhost:3000

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local Firebase / cloud functions (deploy separately — do not commit)
cloud functions/

# Knowledge quiz — local testing only
# EXPO_PUBLIC_KNOWLEDGE_SET_OVERRIDE=onboarding|q1|q2|q3|q4
# EXPO_PUBLIC_KNOWLEDGE_IS_FIRST_ASSESSMENT=false
# EXPO_PUBLIC_KNOWLEDGE_TEST_MONTH=6

# Strength — office / dev testing without filming a plank
# EXPO_PUBLIC_STRENGTH_DEV_SKIP_POSE_CHECK=true

# Assessment — allow retaking within the same quarter (dev / QA only)
# EXPO_PUBLIC_ALLOW_MULTIPLE_ASSESSMENTS_PER_QUARTER=true

# Assessment — auto-create current quarter doc via cloud function when tapping Start assessment
# EXPO_PUBLIC_DEV_SEED_QUARTERLY_ASSESSMENT=true
# Optional override (defaults to europe-west2-{EXPO_PUBLIC_FIREBASE_PROJECT_ID}.cloudfunctions.net/...)
# EXPO_PUBLIC_DEV_SEED_QUARTERLY_ASSESSMENT_URL=https://europe-west2-kale-staging-17edd.cloudfunctions.net/devSeedQuarterlyAssessment
