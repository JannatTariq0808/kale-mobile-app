  "scripts": {
    "start": "expo start --dev-client",
    "start:lan": "expo start --dev-client --lan --clear",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:go": "expo start",
    "android": "node scripts/ensure-android-sdk.mjs && node scripts/patch-android-gradle-memory.mjs && node scripts/generate-android-autolinking.mjs && expo run:android",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:ios:production": "APP_VARIANT=production expo prebuild --platform ios --clean",
    "prebuild:ios:staging": "APP_VARIANT=staging expo prebuild --platform ios --clean",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web",
    "generate:assets": "node scripts/generate-brand-assets.mjs",
    "generate:app-store-screenshots": "node scripts/generate-app-store-screenshots.mjs",
    "patch:android-splash": "node scripts/patch-android-splash.mjs",
    "prebuild:android": "expo prebuild --platform android --clean && node scripts/ensure-android-sdk.mjs && node scripts/patch-android-gradle-memory.mjs && node scripts/patch-android-splash.mjs && node scripts/generate-android-autolinking.mjs",
    "generate:well-known": "node scripts/generate-well-known.mjs",
    "seed:strength-questions": "node scripts/seed-strengthQuestions.mjs",
    "seed:knowledge-questions": "node scripts/seed-knowledgeQuestions.mjs",
    "seed:kalettes-questions": "node scripts/seed-kalettesQuestions.mjs",
    "seed:cardio-questions": "node scripts/seed-cardioQuestions.mjs",
    "seed:vo2-questions": "node scripts/seed-vo2Questions.mjs",
    "seed:all-faqs": "node scripts/seed-all-faqs.mjs",
    "seed:rewards-products": "node scripts/seed-rewardsProducts.mjs",
    "seed:running-years": "node scripts/seed-runningYears.mjs"
  },
  "private": true
}
