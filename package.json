  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.1.10",
    "firebase-admin": "^14.0.0",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
